# === МАКС (основная площадка) ===
# Токен бота от @MasterBot внутри мессенджера МАКС.
MAX_BOT_TOKEN=
# MAX user_id операторов через запятую (узнать: команда /myid в боте).
MAX_ADMIN_IDS=
# Чат проверки чеков. Пусто = запомнится, когда оператор впервые напишет боту /admin или /draw.
MAX_ADMIN_CHAT_ID=
# Владельцы (супер-админы) — MAX user_id через запятую. Доступ к панели /panel
# (тексты, число победителей, расписание, рассылка). Владелец автоматически и оператор.
MAX_OWNER_IDS=

# === Telegram (опционально) ===
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# === ВКонтакте (опционально) ===
# Токен сообщества (Управление -> Работа с API -> Ключи доступа).
# Права: сообщения сообщества, фото/вложения. В настройках Long Poll API включить события.
# Если оставить пустым — ВК-бот не запустится, будет работать только Telegram.
VK_GROUP_TOKEN=

# === Операторы (админы) ===
# Telegram user id операторов через запятую (узнать свой id можно у @userinfobot).
ADMIN_IDS=111111111,222222222

# Чат, куда бот присылает чеки на проверку (обычно личка первого оператора).
# Если пусто — берётся первый id из ADMIN_IDS.
ADMIN_CHAT_ID=

# === Розыгрыш ===
# Сколько победителей по умолчанию (оператор может менять командой /winners N).
DEFAULT_WINNERS_COUNT=3

# Когда автоматически запускать розыгрыш (по времени TIMEZONE).
DRAW_DAY=mon
DRAW_HOUR=10
DRAW_MINUTE=0
TIMEZONE=Europe/Moscow

# === Хранилище ===
DB_PATH=data/bot.db
MEDIA_DIR=data/media
